#[test]
fn blobify_bstf() {
    const object = new {
        msg: 'hello, world',
        val: 42,
    };
    const bytes = blobify('bstf', object);
    assert_eq(typeof bytes, 'blob');

    const dest = new {};
    parse(bytes, dest, 'bstf');
    assert_eq(dest.msg, 'hello, world');
    assert_eq(dest.val, 42);

    drop(dest);
    drop(object);
}


Types: {
    #[type]
    BstfType: {
        str message: '';
        ms ts: 0ms;

        fn create(message: str, on: obj = self) -> BstfType {
            new BstfType {
                message,
                ts: Time.now(),
            } on on
        }
    }

    #[test]
    fn roundtrip_bstf_types() {
        // must use an 'on', because static functions put the type as self...
        const msg = <BstfType>.create('hello, bstf', self);
        const bytes = blobify('bstf', self);
        const msg_id = msg.id();
        drop(msg);
        drop(self.BstfType);
        // now self is empty apart from this function
        
        const dest = new {};
        parse(bytes, dest, 'bstf');
        
        const dest_msg = Obj.from_id(msg_id);
        assert_eq(dest_msg.parent(), dest);
        assert_eq(dest_msg.message, 'hello, bstf');
        assert(dest_msg.ts < Time.now());
        assert_eq(typeof dest.roundtrip_bstf_types, 'fn');

        assert_eq(dest.children().len(), 2);
        const type_test = dest.BstfType.create('yo');
        assert_eq(type_test.message, 'yo');
        assert_eq(type_test.parent(), self);

        drop(type_test);
        drop(dest);
    }
}

#[test]
/// BSTF keeps infinity and NaN exactly (including units).
fn bstf_non_finite() {
    const inf = 1.0 / 0.0;
    const o = new {};
    parse(blobify('bstf', new { a: inf, b: -inf, c: 0.0 / 0.0, d: inf as kg }), o, 'bstf');
    assert_eq(o.a, inf);
    assert_eq(o.b, -inf);
    assert(o.c.nan());
    assert_eq(o.d, inf as kg);
}

#[test]
/// Parsing an export back into the same document makes a copy: objects whose IDs are taken get new ones.
fn bstf_reimport_copies() {
    using original = new { name: 'tiers', tiers: [new { up_to: 10 }, new { up_to: 20 }], inner: new { x: 1 } };
    const bytes = blobify('bstf', original);
    using copy = new {};
    parse(bytes, copy, 'bstf');

    assert_eq(original.name, 'tiers');           // the original is untouched
    assert_eq(original.inner.x, 1);
    assert_eq(original.tiers[1].up_to, 20);
    assert_eq(copy.inner.x, 1);                   // and the copy matches it
    assert_eq(copy.tiers[1].up_to, 20);
    assert_neq(copy.inner, original.inner);       // as separate objects
    copy.inner.x = 2;
    assert_eq(original.inner.x, 1);
}
