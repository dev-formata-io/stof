#[test]
fn stringify_yaml() {
    const object = new {
        a: 'hello',
        b: 42,
        c: true,
    };
    const yaml = stringify('yaml', object);
    drop(object);

    assert_eq(typeof yaml, 'str');
    assert_eq(yaml, 'a: hello\nb: 42\nc: true\n');
}

#[test]
fn parse_yaml() {
    const yaml = 'a: hello\nb: 42\nc: true\n';
    const object = new {};
    parse(yaml, object, format = 'yaml');
    
    assert_eq(object.a, 'hello');
    assert_eq(object.b, 42);
    assert(object.c);
    assert_eq(stringify('yaml', object), yaml);
    drop(object);
}

Imports: {
    import './test.yaml';
    import yaml './test.yaml' as self.Imported;

    #[test]
    fn import_yaml() {
        assert_eq(self.message, 'hello, world');
        assert_eq(self.person.name, 'Bob Smith');
        assert_eq(self.person.age, 42);

        assert_eq(self.Imported.message, 'hello, world');
        assert_eq(self.Imported.person.name, 'Bob Smith');
        assert_eq(self.Imported.person.age, 42);
    }
}

#[test]
/// YAML has its own infinity and NaN (.inf, -.inf, .nan): written and read as numbers.
fn non_finite() {
    const o = new { a: Infinity, b: -Infinity, c: NaN, l: [Infinity, NaN] };
    const yaml = stringify('yaml', o);
    assert_eq(yaml, 'a: .inf\nb: -.inf\nc: .nan\nl:\n- .inf\n- .nan\n');
    const back = new {};
    parse(yaml, back, 'yaml');
    assert_eq(back.a, Infinity);
    assert_eq(back.b, -Infinity);
    assert(back.c.nan());
    assert_eq(back.l[0], Infinity);
    assert(back.l[1].nan());
    drop(o);
    drop(back);

    const other = new {};
    parse('x: .Inf\ny: -.INF\nz: .NaN\ns: Infinity\nq: "text"', other, 'yaml');
    assert_eq(other.x, Infinity);
    assert_eq(other.y, -Infinity);
    assert(other.z.nan());
    assert_eq(other.s, Infinity);                   // the word JSON uses reads the same way
    assert_eq(other.q, 'text');
    drop(other);
}
