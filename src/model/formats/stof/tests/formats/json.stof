#[test]
fn stringify_json() {
    const object = new {
        a: 'hello',
        b: 42,
        c: true,
    };
    const json = stringify('json', object);
    drop(object);

    assert_eq(typeof json, 'str');
    assert_eq(json, '{"a":"hello","b":42,"c":true}');
}

#[test]
fn parse_json() {
    const json = '{"a":"hello","b":42,"c":true}';
    const object = new {};
    parse(json, object, format = 'json');
    
    assert_eq(object.a, 'hello');
    assert_eq(object.b, 42);
    assert(object.c);
    assert_eq(stringify('json', object), json);
    drop(object);
}

Imports: {
    import './test.json'; // default use self as scope
    import json './test.json' as self.Imported; // format and path

    #[test]
    fn import_json() {
        assert_eq(self.message, 'hello, world');
        assert_eq(self.person.name, 'Bob Smith');
        assert_eq(self.person.age, 42);

        assert_eq(self.Imported.message, 'hello, world');
        assert_eq(self.Imported.person.name, 'Bob Smith');
        assert_eq(self.Imported.person.age, 42);
    }
}

#[test]
/// JSON has no infinity or NaN: they export as the strings "Infinity", "-Infinity", and "NaN" (it used to panic, then
/// write null). Units aren't written in JSON, for any number.
fn stringify_non_finite() {
    const doc = new { a: 1.0 / 0.0, b: -1.0 / 0.0, c: 0.0 / 0.0, d: 1.5, e: [1.0 / 0.0, 2], f: (1.0 / 0.0) as kg };
    assert_eq(stringify('json', doc), '{"a":"Infinity","b":"-Infinity","c":"NaN","d":1.5,"e":["Infinity",2],"f":"Infinity"}');
}

#[test]
/// JSON has no infinity or NaN: they're the strings "Infinity", "-Infinity", and "NaN", which read back as numbers.
fn non_finite() {
    const o = new { a: Infinity, b: -Infinity, c: NaN, l: [Infinity, NaN], n: new { x: -Infinity }, s: 'Infinity and beyond' };
    const json = stringify('json', o);
    assert(json.contains('"a":"Infinity"'), json);
    assert(json.contains('"b":"-Infinity"'), json);
    assert(json.contains('"c":"NaN"'), json);
    const back = new {};
    parse(json, back, 'json');
    assert_eq(back.a, Infinity);
    assert_eq(back.b, -Infinity);
    assert(back.c.nan());
    assert_eq(back.l[0], Infinity);
    assert(back.l[1].nan());
    assert_eq(back.n.x, -Infinity);
    assert_eq(back.s, 'Infinity and beyond');       // only the exact words are numbers
    drop(o);
    drop(back);

    const words = new {};
    parse('{"a": "infinity", "b": "inf", "c": "nan", "d": "Infinity"}', words, 'json');
    assert_eq(words.a, 'infinity');
    assert_eq(words.b, 'inf');
    assert_eq(words.c, 'nan');
    assert_eq(words.d, Infinity);
    drop(words);
}
