/*!
 * Evaluation order: expressions run left to right, like most languages.
 * Scope: root.Lang.Order
 */

#[test]
fn operands_left_to_right() {
    using rec = new { seen: [] };
    const track = (v: unknown): unknown => { rec.seen.push_back(v); v };
    const sum = track(1) + track(2);
    assert_eq(sum, 3);
    assert_eq(rec.seen, [1, 2]);

    rec.seen = [];
    track(1) * track(2) + track(3) * track(4);
    assert_eq(rec.seen, [1, 2, 3, 4]);

    rec.seen = [];
    track(5) < track(6);
    track(7) == track(8);
    assert_eq(rec.seen, [5, 6, 7, 8]);
}

#[test]
fn side_effects_left_to_right() {
    const items = [1, 2, 3];
    assert_eq(items.len() + items.pop_back(), 6);      // 3 + 3: len runs first
    const more = [1, 2, 3];
    assert_eq(more.pop_back() - more.len(), 1);        // 3 - 2
}

#[test]
fn templates_left_to_right() {
    const items = [1, 2, 3];
    assert_eq(`${items.len()} then ${items.pop_back()} then ${items.len()}`, '3 then 3 then 2');
}

#[test]
fn results_unchanged() {
    assert_eq(10 - 4, 6);
    assert_eq(10 / 4, 2);
    assert_eq(10 % 4, 2);
    assert_eq(2 - 3 - 4, -5);
    assert_eq(100 / 10 / 5, 2);
    assert(3 < 4);
    assert_not(4 < 3);
    assert(4 >= 4);
    assert_eq(6 & 3, 2);
    assert_eq(1 << 3, 8);
    assert_eq(`${'a'}${1}${'b'}${2}`, 'a1b2');
    assert_eq('ab' + 'cd', 'abcd');
}

#[test]
fn compound_assignment_reads_first() {
    let x = 10;
    x -= 4;
    x *= 3;
    x /= 2;
    assert_eq(x, 9);

    let s = 'a';
    s += 'b';
    assert_eq(s, 'ab');
}
