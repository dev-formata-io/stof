/*!
 * Variable scoping in function calls.
 * Scope: root.Lang.Funcs.Scoping
 */

fn reads_secret() -> unknown { return secret; }           // "secret" isn't declared here
fn calls_reader() -> unknown { const secret = 'caller'; return self.reads_secret(); }

#[test]
/// A named function only sees its own variables, never its caller's.
fn no_dynamic_scoping() {
    assert_null(self.calls_reader());
}

fn typo(total: int) -> unknown { return totl; }            // typo for "total"
fn calls_typo() -> unknown { const totl = 100; return self.typo(5); }

#[test]
/// A misspelled name doesn't silently bind to a caller's variable.
fn typos_do_not_bind_to_callers() {
    assert_null(self.calls_typo());
}

fn second(q: int, r: int) -> int { return r; }

#[test]
/// Arguments are evaluated in the caller's scope: a later argument never sees the callee's earlier params.
fn arguments_use_the_callers_variables() {
    const q = 7;
    assert_eq(self.second(1, q), 7);                        // used to be 1 (the callee's q)
    assert_eq(self.second(q = 2, r = q), 7);
}

fn doubled(a: int, b: int = a * 2) -> int { return b; }

#[test]
/// A default value can use earlier parameters.
fn defaults_use_earlier_params() {
    assert_eq(self.doubled(3), 6);
    assert_eq(self.doubled(3, 1), 1);
}

#[test]
/// Arrow functions see the variables of the function they're used in (closure-like).
fn arrow_functions_see_enclosing_variables() {
    const offset = 10;
    const add = (x: int): int => x + offset;
    assert_eq(add(1), 11);

    let list = [3, 1, 2];
    list.sort_by((a: int, b: int): int => (a - b) * offset);  // through a library function
    assert_eq(list, [1, 2, 3]);
}

fn throws() -> str { const inner = 'x'; throw('boom'); }

#[test]
/// After catching an error from a call, the catch block sees this function's variables again.
fn catch_restores_scope() {
    let caught = false;
    try { self.throws(); }
    catch { caught = true; }
    assert(caught);
    assert_null(?inner);
}

fn takes_two(units: int, rate: float = 2) -> float { units * rate }

#[test]
fn argument_errors_catch_as_func_args() {
    let caught = [];
    try { self.takes_two(); } catch (e: str) { caught.push_back(e); }
    try { self.takes_two(1, 2, 3); } catch (e: str) { caught.push_back(e); }
    try { self.takes_two(nope = 1); } catch (e: str) { caught.push_back(e); }
    try { Num::abs(); } catch (e: str) { caught.push_back(e); }
    assert_eq(caught, ['FuncArgs', 'FuncArgs', 'FuncArgs', 'FuncArgs']);
}


/*****************************************************************************
 * Arrow functions keep the variables where they were made, wherever they're called.
 *****************************************************************************/

fn apply_rule(amount: float, rule: fn) -> float { rule(amount) }
fn call_with(value: int, f: fn) { f(value); }
fn call_stored() -> float { self.stored_rule(100) }

#[test]
fn arrow_passed_to_function_sees_its_variables() {
    const tax = 0.2;
    const with_tax = (amount: float): float => amount * (1 + tax);
    assert_eq(self.apply_rule(100, with_tax), 120);
}

#[test]
fn arrow_stored_and_called_later() {
    const rate = 0.5;
    self.stored_rule = (amount: float): float => amount * rate;
    assert_eq(self.call_stored(), 50);
}

#[test]
fn arrow_assigns_captured_variable() {
    let total = 0;
    const add = (v: int) => { total += v; };
    add(5);
    self.call_with(10, add);
    assert_eq(total, 15);

    total = 100;
    const read = (): int => total;
    assert_eq(self.apply_rule(0, (x: float): float => read()), 100);
}

#[test]
fn captured_variables_keep_copy_semantics() {
    let x = 1;
    const f = (): int => x;
    let y = x;
    y += 10;
    assert_eq(x, 1);
    assert_eq(f(), 1);
    x = 7;
    assert_eq(f(), 7);
}

#[test]
fn arrow_recursion_and_nesting() {
    const fact = (n: int): int => n <= 1 ? 1 : n * fact(n - 1);
    assert_eq(fact(5), 120);

    const offset = 10;
    const make = (): fn => (x: int): int => x + offset;
    assert_eq(self.apply_rule(1, make()), 11);
}
