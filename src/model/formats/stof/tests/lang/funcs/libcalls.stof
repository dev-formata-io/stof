/*!
 * Explicit library calls: Lib::func(args) always calls the library.
 * Lib.func(args) looks for an object (or variable) named Lib first, then the library.
 * Scope: root.Lang.Funcs.LibCalls
 */

// An object named like a library never changes Num.func(..) calls: paths without self/super start
// at a graph root, so only a root named "Num" (Ex. root Num {..}) is consulted before the library.
Inner: {
    Num: {
        fn round(v: float, places: int) -> str { return 'nested'; }
    }
}


#[test]
fn explicit_library_call() {
    assert_eq(Num::round(2.567, 1), 2.6);
    assert_eq(Num::abs(-3), 3);
    assert_eq(Str::upper('abc'), 'ABC');
    assert_eq(Std::str(5), '5');
}

#[test]
fn explicit_and_path_forms_agree() {
    assert_eq(Num::round(2.567, 1), Num.round(2.567, 1));
    assert_eq(Num.round(2.567, 1), 2.6);
    assert_eq(self.Inner.Num.round(2.567, 1), 'nested'); // the object is still reachable by path
}

#[test]
fn explicit_call_ignores_shadowing_variables() {
    let Num = 3;
    const Str = 'not a library';
    assert_eq(Num::abs(-2), 2);
    assert_eq(Str::len('four'), 4);
    assert_eq(Num, 3);
}

fn uses_param(Num: int) -> int {
    return Num::abs(Num) + 1;
}

#[test]
fn explicit_call_ignores_shadowing_params() {
    assert_eq(self.uses_param(-4), 5);
}

#[test]
fn explicit_call_in_expressions_and_chains() {
    assert_eq(Num::abs(-3) + Num::max(1, 5) * 2, 13);
    assert_eq(Num::round(-2.567, 1).abs(), 2.6);
    assert_eq(?Num::round(1.26, 1), 1.3);
    const list = [Num::abs(-1), Num::abs(-2)];
    assert_eq(list, [1, 2]);
    assert_eq(`v${Num::abs(-7)}`, 'v7');
}

#[test]
fn explicit_call_to_missing_function_errors() {
    let failed = false;
    try { Num::not_a_function(1); } catch { failed = true; }
    assert(failed);

    failed = false;
    try { NotALibrary::func(1); } catch { failed = true; }
    assert(failed);
}

#[test]
/// Lib?::func(..) is null when the library or function doesn't exist (Ex. an optional host library).
fn null_safe_library_call() {
    assert_eq(NotALibrary?::func(1), null);
    assert_eq(Num?::not_a_function(1), null);
    assert_eq(Num?::abs(-3), 3);                // present: a normal call
    assert_eq(?NotALibrary::func(1), null);     // the leading form works too
    assert_eq(NotALibrary?::func(1) ?? 'fallback', 'fallback');
}
