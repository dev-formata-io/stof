#[test]
fn return_from_try() {
    const func = ():int => {
        try {
            return 42;
        } catch {
            return 100;
        }
    };
    assert_eq(func(), 42);
}

#[test]
fn try_error_val() {
    let caught;

    try throw({42, 78, 'hi'});
    catch (error: unknown) {
        caught = true;
        assert_eq(error, {42, 78, 'hi'});
    }

    assert(caught);
}

#[test]
fn std_error() {
    let caught;

    try Std.DNE('this function does not exist');
    catch (error: str) {
        caught = true;
        assert(error.contains('FuncDne'));
    }

    assert(caught);
}

#[test]
fn nested_try() {
    let caught;
    try {
        try {
            try {
                throw('hello')
            } catch (error: str) {
                throw(error + ', world');
            }
        } catch (error: str) {
            throw(error + '!!');
        }
    } catch (error: str) {
        caught = error;
    }
    assert_eq(caught, 'hello, world!!');
}

#[test]
fn complex_try_return() {
    const func = (): int => {
        try {
            42
        } catch {
            72
        }
    };
    const res = func();

    let cpx = false;
    try assert(false); // this is a thing
    catch {
        try assert_eq(res, 77); // false
        catch {
            assert_eq(res, 42);
            cpx = true;
        }
    }
    assert(cpx);
}


fn load_plugin(src: str, data: unknown) -> obj {
    const sandbox = new { data: data };
    parse(src, sandbox);
    sandbox
}

#[test]
fn try_catch_from_example_plugin() {
    const good_plugin = "fn transform() -> str { self.data.upper() }";
    const good = self.load_plugin(good_plugin, "hello, plugin");
    assert_eq(good.transform(), 'HELLO, PLUGIN');

    const bad_plugin = "fn transform() -> str { HttpDNE.fetch('https://evil.example') }";
    const bad = self.load_plugin(bad_plugin, "hello, plugin");

    let gothere = false;
    try bad.transform();
    catch gothere = true;
    assert(gothere);
}


fn poison(x: str) -> str { x }
fn throws() -> str { throw('boom'); }

#[type]
Widget: {
    label: 'widget'
    fn describe() -> str { self.label }
}

#[test]
fn try_catch_arg_eval_throw_does_not_corrupt_state() {
    const w = new Widget {};

    let caught = false;
    try {
        self.poison(self.throws());
    } catch {
        caught = true;
    }
    assert(caught);

    // If call_stack/self_stack/ret_valid_stack got corrupted by the catch, one of these
    // would misbehave or throw a spurious FuncInvalidReturn/SelfStackError - not because
    // this code is wrong, but because of leftover state from the aborted poison() call.
    assert_eq(self.poison('still fine'), 'still fine');
    assert_eq(w.describe(), 'widget');
}


#[if(lib('Age'))]
ExampleContext: {
    #[type]
    ShareLink: {
        ms expires: 0
        payload: null
    
        fn valid() -> bool {
            Time.now() < self.expires
        }
    
        fn open(passphrase: str) -> obj {
            if (!self.valid()) throw('link expired');
    
            const decrypted = new {};
            Age.pass_parse(passphrase, self.payload, decrypted);
            decrypted
        }
    }
    
    #[test]
    fn example_age_context() {
        const secret = new { file: "quarterly-report.pdf" };
        const payload = Age.pass_blobify("open-sesame", context = secret);
    
        const link = new ShareLink { expires: Time.now() + 1hr, payload: payload };
        pln(link.open("open-sesame").file);
    
        const stale = new ShareLink { expires: Time.now() - 1hr, payload: payload };
        try { stale.open("open-sesame"); }
        catch (msg: str) { pln('blocked:', msg); }
    }
}


#[test]
/// The catch variable is scoped to its catch block: the same name can be caught again later.
fn catch_variable_scope() {
    let seen = [];
    try { throw('a'); } catch (e: str) { seen.push_back(e); }
    try { throw('b'); } catch (e: str) { seen.push_back(e); }
    assert_eq(seen, ['a', 'b']);
    assert_null(?e);
}

#[test]
/// catch (e, message): the error as always, and its readable message.
fn catch_message() {
    let code = ''; let text = '';
    try nanoid(0);
    catch (e: str, message: str) { code = e; text = message; }
    assert_eq(code, 'FuncArgs');
    assert_eq(text, 'nanoid length must be from 1 to 4096 (got 0)');

    try assert_eq(1, 2, 'totals');
    catch (e, message) text = message;
    assert_eq(text, "assertion failed: totals: '1' does not equal '2'");

    try throw('plain text');
    catch (e, message) { code = e; text = message; }
    assert_eq(code, 'plain text');
    assert_eq(text, 'plain text');

    let thrown = null;
    try throw({1, 2});
    catch (e, message: str) { thrown = e; text = message; }
    assert_eq(thrown, {1, 2});
    assert(text.contains('error thrown'), text);

    // the one-name and no-name forms are unchanged
    try nanoid(0);
    catch (e: str) code = e;
    assert_eq(code, 'FuncArgs');
    let caught = false;
    try nanoid(0);
    catch caught = true;
    assert(caught);
}

#[test]
/// The message variable is scoped to its catch block, like the error.
fn catch_message_scope() {
    try throw('a'); catch (e, message) {}
    try throw('b'); catch (e, message) { assert_eq(message, 'b'); }
}

looper: {
    fn throws_in_loop() -> int { let i = 0; while (i < 10) { i += 1; if (i > 3) throw('in a loop'); } i }
    fn throws_in_nested_loops() -> int { for (const a in [1, 2]) { for (const b in [1, 2, 3]) { if (b > 1) throw('nested'); } } 0 }
}

#[test]
/// An error thrown in a loop inside a called function: the catch block still sees this function's variables.
fn catch_after_a_loop_in_a_call() {
    let res = 'none';
    try self.looper.throws_in_loop();
    catch (e, message) res = message;
    assert_eq(res, 'in a loop');

    let count = 0;
    for (const round in [1, 2]) {
        try self.looper.throws_in_nested_loops();
        catch count += 1;
    }
    assert_eq(count, 2, "the caller's own loop and variables survive");
}
