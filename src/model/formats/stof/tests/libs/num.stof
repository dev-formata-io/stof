Ops: {
    #[test]
    fn absolute_value() {
        assert_eq((-23).abs(), 23);
        assert_eq((-5.).abs(), 5.0);
    }

    #[test]
    fn square_root() {
        assert_eq((4).sqrt(), 2);
    }

    #[test]
    fn cube_root() {
        assert_eq((8).cbrt(), 2);
    }

    #[test]
    fn floor() {
        assert_eq((5.7).floor(), 5);
    }

    #[test]
    fn ceil() {
        assert_eq((5.7).ceil(), 6);
    }

    #[test]
    fn trunc() {
        assert_eq((5.7).trunc(), 5);
    }

    #[test]
    fn fract() {
        assert_eq((5.7).fract().round(2), 0.7);
    }

    #[test]
    fn signum() {
        assert_eq((4).signum(), 1);
        assert_eq((-4).signum(), -1);
    }

    #[test]
    fn exp() {
        assert_eq((1).exp().round(3), 2.718);
    }

    #[test]
    fn exp2() {
        assert_eq((2).exp2(), 4);
    }

    #[test]
    fn ln() {
        assert_eq((1).ln(), 0);
    }

    #[test]
    fn pow() {
        assert_eq((2).pow(4), 16);
    }

    #[test]
    fn log() {
        assert_eq((2).log().round(3), 0.301);
    }

    #[test]
    fn atan2() {
        assert_eq(Num.atan2(1, 2).round(3), 0.464);
    }

    #[test]
    fn strings() {
        const x = 10;
        assert_eq(x.to_string(), '10');
        assert_eq(x.hex(), 'A');
        assert_eq(x.oct(), '12');
        assert_eq(x.bin(), '1010');
    }
}

Units: {
    #[test]
    fn has_units() {
        let x = 10m;
        let y = 10;
        assert(x.has_units());
        assert(!y.has_units());
    }

    #[test]
    fn to_units() {
        const val = 10kg;
        const units = 'g';
        assert_eq(val.to_units(units), 10_000);
        assert_eq(val, 10); // unmodified

        assert_eq(val.to_units(50mg), 10_000_000);
        assert_eq(typename val.to_units('mg'), 'mg');
        assert_eq(val, 10);

        const clone = val.to_units('float'); // keep any prior units
        assert_eq(clone, 10);
        assert_eq(typename clone, 'kg');

        const mod = val.to_units('int'); // will work, but eh..
        assert_eq(mod, 10);
        assert_eq(typename mod, 'int');
    }

    #[test]
    #[errors]
    fn to_units_fails() {
        const val = 42;
        val.to_units('rg'); // units do not exist
    }
    
    #[test]
    fn remove_units() {
        let x = 10kg;
        const y = x.remove_units();
        assert(!y.has_units());
        assert_eq(typeof y, 'float');
        assert(x.has_units()); // numbers are values: x keeps its units
    }

    #[test]
    fn is_angle() {
        let x = 30deg;
        let y = 30;
        assert(x.is_angle());
        assert(!y.is_angle());
    }

    #[test]
    fn is_temp() {
        let x = 212F;
        let y = 212;
        assert(x.is_temp());
        assert(!y.is_temp());
    }

    #[test]
    fn is_length() {
        let x = 5280ft;
        let y = 5280;
        assert(x.is_length());
        assert(!y.is_length());
    }

    #[test]
    fn is_mass() {
        let x = 24kg;
        let y = 24;
        assert(x.is_mass());
        assert(!y.is_mass());
    }
    
    #[test]
    fn is_time() {
        let x = 34s;
        let y = 34;
        assert(x.is_time());
        assert(!y.is_time());
    }

    #[test]
    fn is_memory() {
        let x = 10MB;
        let y = 34;
        assert(x.is_memory());
        assert(!y.is_memory());
    }
}

#[test]
fn maximum() {
    let max = Num.max(0, 12, 2, 43, 32, 12);
    assert_eq(max, 43);
}

#[test]
fn max_units() {
    let max = Num.max(2g, 0.5kg, 100mg);
    assert_eq(max, 0.5kg);
}

#[test]
fn max_list() {
    let max = Num.max([34, 32, 100, 23], [24, 56, 300, 43]);
    assert_eq(max, 300);
}

#[test]
fn minimum() {
    let min = Num.min(29, -49, 23, -23);
    assert_eq(min, -49);
}

#[test]
fn min_units() {
    let min = Num.min(100mg, 43g, 1kg);
    assert_eq(min, 100mg);
}

#[test]
fn min_list() {
    let min = Num.min([20, 40, -50, 43], [-3, 23, 34, 15, -34]);
    assert_eq(min, -50);
}

#[test]
fn parse_numbers() {
    let val = '0b001' as int;
    assert_eq(val, 1);

    val = '0xff' as int;
    assert_eq(val, 255);

    val = '0o4' as int;
    assert_eq(val, 4);

    val = '12kg' as float;
    assert_eq(val, 12000g);
}

#[test]
fn parse_unit_numbers() {
    let val = '34GB' as float;
    assert_eq(val, 34000MB);

    let res = false;
    try {
        val = '34DNE' as float;
    } catch {
        res = true;
    }
    assert(res);
}

#[test]
fn num_len() {
    let len = (56).len();
    assert_eq(len, 56);
}

#[test]
fn num_at() {
    const a = 45;

    let at = a.at(5);
    assert_eq(at, 5);
    
    at = a.at(50);
    assert_eq(at, 45);
}

#[test]
fn num_iter() {
    let total = 0;
    // uses .len() & .at(idx) for iteration
    for (const i in 10) {
        if (first) { assert_eq(i, 0); continue; }
        if (last) { assert_eq(i, 9); continue; }

        total += 1;
    }
    assert_eq(total, 8);
}

#[test]
fn units_gen_type() {
    const val = 54kg;
    assert_eq(typename val, 'kg');
    assert_eq(typeof val, 'float');
}


/// Numbers are values: a method call returns a new number and never changes the
/// variable it was called on (locals, params, consts and fields alike).
Values: {
    #[test]
    fn methods_leave_locals_unchanged() {
        let x = -2.567;
        assert_eq(x.abs(), 2.567);
        assert_eq(x, -2.567);

        let y = 2.567;
        assert_eq(y.round(1), 2.6);
        assert_eq(y.round(), 3);
        assert_eq(y, 2.567);

        let w = 3.7;
        assert_eq(w.floor(), 3);
        assert_eq(w.ceil(), 4);
        assert_eq(w.trunc(), 3);
        assert_eq(w, 3.7);

        let p = 16;
        p.sqrt(); // result discarded
        assert_eq(p, 16);
        assert_eq(p.pow(2), 256);
        assert_eq(p.log(2), 4);
        assert_eq(p, 16);

        let m = 5.5m;
        assert_eq(m.remove_units(), 5.5);
        assert(m.has_units());
    }

    #[test]
    fn method_result_in_expression_leaves_local_unchanged() {
        let w = 3.7;
        const r = w.floor() + 1; // the `+` must not write through to `w` either
        assert_eq(r, 4);
        assert_eq(w, 3.7);

        let n = -4;
        let total = n.abs() * 2 - 1;
        assert_eq(total, 7);
        assert_eq(n, -4);
    }

    #[test]
    fn methods_leave_consts_unchanged() {
        const c = -1;
        const d = c.abs();
        assert_eq(d, 1);
        assert_eq(c, -1);
    }

    fn rounded(v: float) -> float {
        const r = v.round(2);
        assert_eq(v, 1.23456); // param unchanged inside the callee
        return r;
    }

    #[test]
    fn methods_leave_params_unchanged() {
        const v = 1.23456;
        assert_eq(self.rounded(v), 1.23);
        assert_eq(v, 1.23456);
    }

    field: -9.5

    #[test]
    fn methods_leave_fields_unchanged() {
        assert_eq(self.field.abs(), 9.5);
        assert_eq(self.field, -9.5);
    }

    #[test]
    fn lib_and_method_forms_agree() {
        let x = -0.1234567891234;
        assert_eq(Num.round(x, 9), x.round(9));
        assert_eq(Num.abs(x), x.abs());
        assert_eq(x, -0.1234567891234);
    }

    #[test]
    fn repeated_calls_are_stable() {
        let x = -3;
        let a = x.abs();
        let b = x.abs();
        assert_eq(a, b);
        assert_eq(x.abs().abs(), 3);
        assert_eq(x, -3);
    }
}


/// Infinity, NaN, overflow and number literals: never a crash, always a defined result.
Edges: {
    #[test]
    fn infinity_and_nan() {
        const inf = 1.0 / 0.0;
        const nan = 0.0 / 0.0;
        assert(inf.inf());
        assert(nan.nan());
        assert(inf > 1e308);
        assert(-inf < -1e308);
        assert_eq(inf, inf);
        assert_neq(nan, nan);                      // IEEE: NaN never equals anything
        assert((inf - inf).nan());
        assert_eq(1 / inf, 0);
        assert_eq(str(inf), 'inf');
        assert_eq(`${-inf}`, '-inf');
        assert((inf as kg) > 5kg);
        assert_eq((inf as kg).to_units('g'), inf as g);
    }

    #[test]
    /// Integer division/remainder by zero follows floats (it used to panic).
    fn integer_division_by_zero() {
        assert_eq(1 / 0, 1.0 / 0.0);
        assert_eq(-1 / 0, -1.0 / 0.0);
        assert((0 / 0).nan());
        assert((1 % 0).nan());
        assert_eq(typeof (1 / 0), 'float');
        assert_eq(7 / 2, 3);                       // ordinary integer division is unchanged
        assert_eq(typeof (7 / 2), 'int');
    }

    #[test]
    /// Integer overflow becomes a float instead of wrapping to a wrong value.
    fn integer_overflow() {
        const max = 9223372036854775807;
        const min = -9223372036854775807 - 1;
        assert_eq(typeof min, 'int');
        assert_eq(typeof (max + 1), 'float');
        assert_eq(max + 1, 9223372036854775808.0);   // not wrapped to a negative number
        assert_eq(min - 1, -9223372036854775808.0);
        assert_eq(max * 2, 18446744073709551614.0);
        assert(min / -1 > 0);
        assert_eq(min % -1, 0);
        assert(min.abs() > 0);
    }

    #[test]
    /// NaN propagates through min/max (like JS Math.min/max), whatever the argument order.
    fn min_max_nan() {
        const nan = 0.0 / 0.0;
        assert(max(nan, 1).nan());
        assert(max(1, nan).nan());
        assert(min(nan, 1).nan());
        assert(min(1, nan).nan());
        assert(max([3, nan, 1]).nan());
        assert_eq(max(1, null, 4), 4);             // null is skipped
        assert_eq(min(3, 1.0 / 0.0, 2), 2);
    }

    #[test]
    /// Sorting and sets use a total order: NaN sorts after every number, NaN and null dedupe in sets.
    fn total_order() {
        const nan = 0.0 / 0.0;
        const inf = 1.0 / 0.0;
        let l = [3, nan, 1, inf, -inf, null, 2];
        l.sort();                                  // used to panic
        assert_eq(str(l), '[-inf, 1, 2, 3, inf, NaN, null]');
        assert_eq(set(null, 1, null).len(), 2);
        assert_eq(set(nan, nan, 1).len(), 2);
    }

    #[test]
    /// Integer literals are exact (they used to go through f64); too large for an int is a float.
    fn number_literals() {
        assert_eq(str(9007199254740993), '9007199254740993');
        assert_eq(str(9223372036854775806), '9223372036854775806');
        assert_eq(typeof 99999999999999999999, 'float');
        assert_eq(0x10-1, 15);                     // used to panic ("-1" read as hex digits)
        assert_eq(0b101-1, 4);
        assert_eq(-0x10, -16);
        assert_eq(0x1_0000, 65536);
        assert_eq(typeof 0xFFFFFFFFFFFFFFFF, 'float');
        assert_eq(typeof 1e3, 'int');
        assert_eq(0x10kg, 16kg);
    }
}

