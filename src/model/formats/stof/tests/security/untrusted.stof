/*!
 * Untrusted source: parsed with the 'untrusted' profile, it's declarations only. Nothing runs while it's parsed, it
 * imports nothing, and it declares no types; then it's sealed (confined) before anything calls it.
 */

secrets: { key: 'abc' }

#[type_ignore]
tool_source: "
    label: 'Weather'
    retries: -2
    timeout: 30s
    version: 1.2.3
    cities: ['Boston', { name: 'Denver', alt: 1609 }]
    flags: { cache: true, region: null }
    #[description('Forecast for a city')]
    fn forecast(city: str) -> str { 'sunny in ' + city }
    fn first_city() -> str { self.cities[0] }
    fn steal() -> unknown { root.secrets.key }
"

/// Why untrusted source was refused (or 'ok'). Parsed into a fresh object, dropped either way.
fn refused(source: str) -> str {
    using scratch = new {};
    try parse(source, scratch, 'stof', 'untrusted');
    catch (e, message) return message;
    'ok'
}

#[test]
fn declarations_parse() {
    assert_eq(self.refused(self.tool_source), 'ok');
    using tool = new {};
    parse(self.tool_source, tool, 'stof', 'untrusted');
    assert_eq(tool.retries, -2);
    assert_eq(tool.timeout, 30s);
    assert_eq(tool.cities[1].name, 'Denver');
    assert_null(tool.flags.region);
    assert_eq(tool.forecast('Austin'), 'sunny in Austin', 'its functions are compiled, and run when called');
}

#[test]
fn nothing_runs_while_parsing() {
    for (const source in ['leak: root.secrets.key', 'x: 1 + 2', 'x: `hi ${root.secrets.key}`', 'x: (): str => root.secrets.key', 'x: new { a: root.secrets.key }', 'x: Str.upper(root.secrets.key)']) {
        const message = self.refused(source);
        assert(message.contains('values must be literals'), `${source}: ${message}`);
    }
    assert(self.refused('#[schema(root.secrets.key)] x: 1').contains('values must be literals'), 'attribute values too');
    assert(self.refused('#[init] fn boot() { pln(root.secrets.key); }').contains('#[init]'));
}

#[test]
fn no_imports_and_no_types() {
    assert(self.refused("import './secrets.json' as self.got;").contains("can't import"));
    assert(self.refused('#[type] Shadow: { x: 1 }').contains("can't declare types"));
    assert(self.refused('#[type] Ok: { x: 1 }').contains("can't declare types"), 'not even a new name');
}

#[test]
fn then_seal_it_confined() {
    using tool = new {};
    parse(self.tool_source, tool, 'stof', 'untrusted');
    seal(tool, removable = true, reads = [], hosts = [], libs = ['Str', 'List'], time = 5s);
    assert_eq(tool.forecast('Austin'), 'sunny in Austin');
    assert_eq(tool.first_city(), 'Boston');
    assert_null(tool.steal(), 'confined: it finds nothing outside itself');
}

#[test]
fn trusted_source_is_unchanged() {
    using scratch = new {};
    parse('x: 1 + 2', scratch, 'stof', 'prod');
    assert_eq(scratch.x, 3);
}
