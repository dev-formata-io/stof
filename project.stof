/*!
 * Project definitions & configurations.
 */
import '@cargo' as Rust;
import pkg '@github' as GitHub;

/// Current version.
const version: 0.11.5

/// Cargo.toml definition.
Cargo cargo: {
    #[type('CargoPackage')]
    package: {
        name: 'stof'
        version: super.super.version
        authors: [
            'CJ Cummings <cj@formata.io>'
        ]
        description: "JSON that runs: JSON with functions, run in a sandbox that can only touch what you hand it. In Rust, JavaScript, and Python."
        license: 'Apache-2.0'
        repository: 'https://github.com/dev-formata-io/stof'
        homepage: 'https://stof.dev'
        keywords: [
            'ai-agents',
            'sandbox',
            'json',
            'rules-engine',
            'dsl',
        ]
        categories: [
            'wasm',
            'encoding',
            'config',
            'development-tools',
            'compilers',
        ]
        exclude: [
            "content/*",
            "web/*",
            "docs/*",
            "stof/*",
            ".github/*",
            ".vscode/*",
            "*.gif",
            "*.png",
        ]
    }

    Target lib: {
        crate-type: ['cdylib', 'lib']
        bench: false
        doctest: false

        #[init]
        fn init_name() {
            // Set the lib name to "pystof" when building for python (default features contains "py" feature).
            if (super.features.default.contains('py')) self.name = 'pystof';
        }
    }

    features: {
        default: ['basic']
        basic: ['stof_std', 'system', 'pkg', 'log', 'stacker']
        full: ['stof_std', 'system', 'pkg', 'log', 'stacker', 'image', 'docx', 'pdf', 'http', 'tokio', 'age_encrypt', 'xml']

        stof_std: ['dep:regex']
        system: []
        pkg: ['dep:zip', 'dep:regex', 'dep:walkdir']
        log: ['dep:log']

        /// grow the stack for deeply nested documents instead of overflowing (native targets; not wasm)
        stacker: ['dep:stacker']
        image: ['dep:image']
        docx: ['dep:docx-rs']
        pdf: ['dep:lopdf', 'image']
        http: ['dep:reqwest']
        tokio: ['dep:tokio']
        age_encrypt: ['dep:age']

        /// xml import (xml export is always there)
        xml: ['dep:quick-xml']

        /// mimalloc as the allocator under StofAlloc (the memory-counting global allocator the Python build uses, and
        /// stof-cli sets): faster than the system allocator (about a fifth off a Limitr allow). Native builds only;
        /// off by default, so Rust users choose their own allocator.
        mimalloc: ['dep:mimalloc']

        /// python bindings for stof with full functionality (TODO min/sandboxing)
        /// when building for python, set this as the only "default" feature
        py: [
            'full',
            'dep:pyo3',
        ]

        /// wasm/js version of the runtime
        /// should be the only feature enabled when building for the wasm target
        js: [
            'stof_std',
            'age_encrypt',
            'xml',
            'dep:js-sys',
            'dep:wasm-bindgen',
            'dep:serde-wasm-bindgen',
            'dep:getrandom',
            'dep:wasm-bindgen-futures',
            'dep:web-sys',
            'dep:console_error_panic_hook',
        ]
    }

    /// Release builds: whole-program optimization (smaller binaries and wasm, slightly faster).
    profile: {
        release: {
            lto: 'fat'
            codegen-units: 1
        }
    }

    dependencies: {
        base64: 0.22.1
        bincode: 1.3.3
        indexmap: {
            version: 2.14.2
            features: ['serde']
        }
        bytes: {
            version: 1.12.1
            features: ['serde']
        }
        colored: 3.1.1
        docx-rs: {
            version: 0.4.22
            optional: true
        }
        image: {
            version: 0.25.10
            features: ['serde']
            optional: true
        }
        lazy_static: 1.5.0
        markdown: {
            version: 1.0.0
            features: ['serde']
        }
        nanoid: 0.4.0
        sha2: 0.10.9
        ed25519-dalek: 2.2.0
        quick-xml: {
            version: 0.41.0
            optional: true
        }
        compact_str: {
            version: 0.9.1
            features: ['serde']
        }
        lopdf: {
            version: 0.45.0
            features: ['serde']
            optional: true
        }
        regex: {
            version: 1.13.1
            optional: true
        }
        serde: {
            version: 1.0.229
            features: ['derive', 'rc']
        }
        serde_json: {
            version: 1.0.151
            features: ['preserve_order']
        }
        serde_yaml: 0.9.34
        toml: {
            version: 0.9.12
            features: ['preserve_order']
        }
        typetag: 0.2.23
        urlencoding: 2.1.3
        walkdir: {
            version: 2.5.0
            optional: true
        }
        zip: {
            version: 4.6.1
            optional: true
            // only what pkg reads and writes: no getrandom 0.3, no C codecs (wasm builds)
            default-features: false
            features: ['bzip2', 'deflate']
        }
        chrono: 0.4.45
        tokio: {
            version: 1.53.1
            features: ['full']
            optional: true
        }
        reqwest: {
            version: 0.12.28
            optional: true
            // rustls with the OS's root certificates instead of the system's OpenSSL: nothing to link, so Python wheels cross-compile (see BUILD.md)
            default-features: false
            features: ['blocking', 'rustls-tls-native-roots', 'charset', 'http2']
        }
        rustc-hash: 2.1.3
        imbl: {
            version: 7.0.2
            features: ['serde', 'triomphe']
        }
        arcstr: {
            version: 1.2.0
            features: ['serde']
        }
        nom: 8.0.0
        parking_lot: {
            version: 0.12.5
            features: ['serde']
        }
        age: {
            version: 0.11.5
            optional: true
            features: ['web-sys'] // use web_sys::SystemTime when wasm target
        }
        log: {
            version: 0.4.34
            optional: true
        }
        stacker: {
            version: 0.1.25
            optional: true
        }
        web-time: {
            version: 1.1.0
            features: ['serde']
        }
        mimalloc: {
            version: 0.1.52
            optional: true
            default-features: false
        }

        /*****************************************************************************
         * Python features.
         *****************************************************************************/
        pyo3: {
            version: 0.29.3
            optional: true
            features: [
                'macros',
                'chrono',
                'chrono-tz',
                'hashbrown',
                'indexmap',
                'generate-import-lib',
                'extension-module',
                // the stable ABI: one wheel per platform for every CPython 3.8+ (see BUILD.md)
                'abi3-py38',
            ]
        }

        /*****************************************************************************
         * JS features.
         *****************************************************************************/
        wasm-bindgen: {
            version: 0.2.129
            optional: true
        }
        wasm-bindgen-futures: {
            version: 0.4.79
            optional: true
        }
        serde-wasm-bindgen: {
            version: 0.6.5
            optional: true
        }
        js-sys: {
            version: 0.3.106
            optional: true
        }
        getrandom: {
            version: 0.2.17
            optional: true
            features: ['js']
        }
        web-sys: {
            version: 0.3.106
            optional: true
            features: ['console', 'Window']
        }
        console_error_panic_hook: {
            version: 0.1.7
            optional: true
        }
    }
}

/// GitHub.
github: {
    funding: 'dev-formata-io'
    
    #[run]
    workflows: [
        {
            name: 'Rust'
            on: {
                push: {
                    branches: ['main']
                }
                pull_request: {
                    branches: ['main']
                }
            }
            env: {
                CARGO_TERM_COLOR: 'always'
            }
            jobs: {
                build: {
                    runs-on: 'ubuntu-latest'
                    steps: [
                        {
                            uses: 'actions/checkout@v4'
                        },
                        {
                            name: 'Build'
                            run: 'cargo build --verbose'
                        },
                        {
                            name: 'Run tests'
                            run: 'cargo test --verbose'
                        },
                        {
                            name: 'Run tests (all features)'
                            run: 'cargo test --verbose --features full'
                        },
                        {
                            name: 'Check the JavaScript build'
                            run: 'cargo check --verbose --features js'
                        }
                    ]
                }
                javascript: {
                    runs-on: 'ubuntu-latest'
                    steps: [
                        {
                            uses: 'actions/checkout@v4'
                        },
                        {
                            uses: 'actions/setup-node@v4'
                            with: { node-version: '22' }
                        },
                        {
                            // the same build as a local release (BUILD.md): default features plus js, optimized by wasm-opt
                            name: 'Build the engine'
                            run: 'rustup target add wasm32-unknown-unknown && cargo install wasm-pack --locked && wasm-pack build --target web --release --out-dir web/pkg -- --no-default-features --features js'
                        },
                        {
                            name: 'Build the package'
                            run: 'npm ci && npm run build'
                            working-directory: 'web'
                        },
                        {
                            name: 'Check the JavaScript build'
                            run: 'node tests/js/check.mjs'
                        }
                    ]
                }
                python: {
                    runs-on: 'ubuntu-latest'
                    steps: [
                        {
                            uses: 'actions/checkout@v4'
                        },
                        {
                            uses: 'actions/setup-python@v5'
                            with: { python-version: '3.12' }
                        },
                        {
                            // pyproject.toml names the module (pystof) and its features for maturin
                            name: 'Build the wheel'
                            run: 'pip install maturin && maturin build --release -o target/wheels && pip install target/wheels/*.whl'
                        },
                        {
                            name: 'Check the Python build'
                            run: 'python tests/python/smoke.py'
                        }
                    ]
                }
            }
        } as GitHub.Workflow,
        {
            // Publishes everything (crates.io, npm, PyPI) for the version in this file. Manual only: it runs when
            // started from the Actions tab (Run workflow), never on a push. Every package is built and tested first,
            // and nothing publishes unless all of them pass. See BUILD.md.
            name: 'Release'
            on: {
                workflow_dispatch: {}
            }
            permissions: {
                contents: 'read'
            }
            env: {
                CARGO_TERM_COLOR: 'always'
            }
            jobs: {
                check: {
                    runs-on: 'ubuntu-latest'
                    steps: [
                        {
                            uses: 'actions/checkout@v4'
                        },
                        {
                            // project.stof writes Cargo.toml and pyproject.toml; the rest are set by hand
                            name: 'Versions match'
                            run: r#"v=$(grep -m1 '^version' Cargo.toml | cut -d'"' -f2); for f in pyproject.toml web/package.json web/doc.ts plugin/.claude-plugin/plugin.json; do grep -q "$v" "$f" || { echo "$f is not $v"; exit 1; }; done; grep -q "^## $v" CHANGELOG.md || { echo "CHANGELOG.md has no $v section"; exit 1; }; echo "releasing $v""#
                        },
                        {
                            name: 'Run tests (all features)'
                            run: 'cargo test --features full'
                        },
                        {
                            name: 'Check the crate'
                            run: 'cargo publish --dry-run'
                        }
                    ]
                }
                npm-build: {
                    runs-on: 'ubuntu-latest'
                    steps: [
                        {
                            uses: 'actions/checkout@v4'
                        },
                        {
                            uses: 'actions/setup-node@v4'
                            with: { node-version: '22' }
                        },
                        {
                            // the same build as a local release (BUILD.md): default features plus js, optimized by wasm-opt
                            name: 'Build the engine'
                            run: 'rustup target add wasm32-unknown-unknown && cargo install wasm-pack --locked && wasm-pack build --target web --release --out-dir web/pkg -- --no-default-features --features js'
                        },
                        {
                            // what prepublishOnly does (the skill, README, and LICENSE, then the build), then pack it
                            name: 'Build the package'
                            run: 'npm ci && npm run skill && npm run readme && npm run build && npm pack'
                            working-directory: 'web'
                        },
                        {
                            name: 'Check the JavaScript build'
                            run: 'node tests/js/check.mjs'
                        },
                        {
                            uses: 'actions/upload-artifact@v4'
                            with: { name: 'npm-package', path: 'web/formata-stof-*.tgz' }
                        }
                    ]
                }
                wheels: {
                    strategy: {
                        // a failing platform doesn't cancel the others, so one run shows every failure
                        fail-fast: false
                        matrix: {
                            include: [
                                { os: 'ubuntu-latest', target: 'x86_64', smoke: true },
                                // built on an ARM runner: the manylinux2014 ARM cross compiler is too old for ring and mimalloc
                                { os: 'ubuntu-24.04-arm', target: 'aarch64', smoke: true },
                                { os: 'windows-latest', target: 'x64', smoke: true },
                                { os: 'macos-latest', target: 'universal2-apple-darwin', smoke: true },
                            ]
                        }
                    }
                    runs-on: '${{ matrix.os }}'
                    steps: [
                        {
                            uses: 'actions/checkout@v4'
                        },
                        {
                            uses: 'actions/setup-python@v5'
                            with: { python-version: '3.12' }
                        },
                        {
                            // one stable-ABI (abi3) wheel per platform: every CPython 3.8+
                            name: 'Build the wheel'
                            uses: 'PyO3/maturin-action@v1'
                            with: { target: '${{ matrix.target }}', args: '--release --out dist', manylinux: '2014' }
                        },
                        {
                            name: 'Check the Python build'
                            "if": 'matrix.smoke'
                            shell: 'bash'
                            run: 'pip install --no-index --find-links dist stof && python tests/python/smoke.py'
                        },
                        {
                            uses: 'actions/upload-artifact@v4'
                            with: { name: 'python-${{ matrix.os }}-${{ matrix.target }}', path: 'dist' }
                        }
                    ]
                }
                sdist: {
                    runs-on: 'ubuntu-latest'
                    steps: [
                        {
                            uses: 'actions/checkout@v4'
                        },
                        {
                            name: 'Build the source package'
                            uses: 'PyO3/maturin-action@v1'
                            with: { command: 'sdist', args: '--out dist' }
                        },
                        {
                            uses: 'actions/upload-artifact@v4'
                            with: { name: 'python-sdist', path: 'dist' }
                        }
                    ]
                }
                // publishing: crates.io, then npm, then PyPI; each skips a version that's already out, so a failed
                // release can be run again. No tokens: each registry trusts this workflow in the "release" environment.
                crates: {
                    needs: ['check', 'npm-build', 'wheels', 'sdist']
                    runs-on: 'ubuntu-latest'
                    environment: 'release'
                    // trusted publishing: the registry trusts this workflow in the release environment (no token)
                    permissions: { contents: 'read', id-token: 'write' }
                    steps: [
                        {
                            uses: 'actions/checkout@v4'
                        },
                        {
                            uses: 'rust-lang/crates-io-auth-action@v1'
                            id: 'auth'
                        },
                        {
                            name: 'Publish to crates.io'
                            run: r#"v=$(grep -m1 '^version' Cargo.toml | cut -d'"' -f2); if curl -sf -A "stof-release" "https://crates.io/api/v1/crates/stof/$v" > /dev/null; then echo "stof $v is already on crates.io"; else cargo publish; fi"#
                            env: { CARGO_REGISTRY_TOKEN: '${{ steps.auth.outputs.token }}' }
                        }
                    ]
                }
                npm: {
                    needs: ['crates']
                    runs-on: 'ubuntu-latest'
                    environment: 'release'
                    // trusted publishing: the registry trusts this workflow in the release environment (no token)
                    permissions: { contents: 'read', id-token: 'write' }
                    steps: [
                        {
                            uses: 'actions/checkout@v4'
                        },
                        {
                            uses: 'actions/setup-node@v4'
                            // Node 24's npm (11.5.1+) does trusted publishing
                            with: { node-version: '24', registry-url: 'https://registry.npmjs.org' }
                        },
                        {
                            uses: 'actions/download-artifact@v4'
                            with: { name: 'npm-package' }
                        },
                        {
                            name: 'Publish to npm'
                            run: r#"npm install -g npm@latest && v=$(node -p "require('./web/package.json').version"); if npm view "@formata/stof@$v" version > /dev/null 2>&1; then echo "@formata/stof $v is already on npm"; else npm publish formata-stof-$v.tgz --access public; fi"#
                        }
                    ]
                }
                pypi: {
                    needs: ['npm']
                    runs-on: 'ubuntu-latest'
                    environment: 'release'
                    // trusted publishing: the registry trusts this workflow in the release environment (no token)
                    permissions: { contents: 'read', id-token: 'write' }
                    steps: [
                        {
                            uses: 'actions/download-artifact@v4'
                            with: { pattern: 'python-*', merge-multiple: true, path: 'dist' }
                        },
                        {
                            name: 'Publish to PyPI'
                            uses: 'pypa/gh-action-pypi-publish@release/v1'
                            with: { skip-existing: true }
                        }
                    ]
                }
            }
        } as GitHub.Workflow
    ]

    #[run]
    /// Generate GitHub FUNDING.yml.
    fn generate_funding_yaml() {
        const object = new { github: self.funding };
        const yaml = stringify('yaml', object);
        drop(object);
        fs.write('.github/FUNDING.yml', yaml);
    }
}


/// pyproject.toml definition.
pyproject: {
    project: {
        name: <CargoPackage>.name
        version: <CargoPackage>.version
        description: <CargoPackage>.description
        license: <CargoPackage>.license
        authors: [
            {
                name: 'CJ Cummings'
                email: 'cj@stof.dev'
            }
        ]
        readme: 'README.md'
        requires-python: '>=3.8'
        classifiers: [
            "Programming Language :: Rust",
            "Programming Language :: Python :: Implementation :: CPython",
            "Programming Language :: Python :: Implementation :: PyPy",
            "License :: OSI Approved :: Apache Software License",
            "Operating System :: OS Independent",
            "Topic :: Software Development :: Interpreters",
            "Topic :: Scientific/Engineering :: Artificial Intelligence",
        ]
        keywords: [
            'sandbox',
            'json',
            'rules-engine',
            'ai-agents',
            'llm',
            'wasm',
            'scripting',
            'embedded',
            'dsl',
        ]
        urls: {
            Documentation: <CargoPackage>.homepage
            Repository: <CargoPackage>.repository
        }
    }

    build-system: {
        requires: ['maturin>=1,<2']
        build-backend: 'maturin'
    }

    // the Python module is pystof (#[pymodule] in src/py), built with the py feature, whatever Cargo.toml's defaults
    tool: {
        maturin: {
            module-name: 'pystof'
            features: ['py', 'mimalloc']
        }
    }
}


/*****************************************************************************
 * Generate functions.
 *****************************************************************************/

/// Generate Cargo.toml file.
async fn generate_cargo_toml() {
    const out = await Rust.Cargo.generate(self.cargo, update = false);
    fs.write('Cargo.toml', out);
    pln('Cargo .. ok');
}


/// Generate python project toml.
async fn generate_pyproject_toml() {
    const out = stringify('toml', self.pyproject);
    fs.write('pyproject.toml', out);
    pln('pyproject .. ok');
}


/// Generate GitHub configurations.
async fn generate_github() {
    self.github.run();
    pln('GitHub .. ok');
}


/*****************************************************************************
 * Main functions.
 *****************************************************************************/

#[main]
/// `stof run project.stof`
fn main() {
    await [
        self.generate_cargo_toml(),
        self.generate_github(),
        self.generate_pyproject_toml(),
    ];
    pln('done');
}


#[javascript]
/// `stof run project.stof -a javascript`
fn javascript_main() {
    // set js features
    self.cargo.features.default = ['js'];

    await [
        self.generate_cargo_toml(),
        self.generate_github(),
    ];
    pln('javascript config done');
}


#[python]
/// `stof run project.stof -a python`
fn python_main() {
    // set py features and name
    self.cargo.features.default = ['py'];
    self.cargo.lib.name = 'pystof';

    await [
        self.generate_cargo_toml(),
        self.generate_github(),
        self.generate_pyproject_toml(),
    ];
    pln('python config done');
}
