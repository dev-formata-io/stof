/*!
 * Project definitions & configurations.
 */
import '@cargo' as Rust;
import pkg '@github' as GitHub;

/// Current version.
const version: 0.10.3

/// Cargo.toml definition.
Cargo cargo: {
    #[type('CargoPackage')]
    package: {
        name: 'stof'
        version: super.super.version
        authors: [
            'CJ Cummings <cj@formata.io>'
        ]
        description: 'Portable, sandboxed logic inside data: JSON with functions you can send anywhere and run safely in Rust, WebAssembly, and Python.'
        license: 'Apache-2.0'
        repository: 'https://github.com/dev-formata-io/stof'
        homepage: 'https://stof.dev'
        keywords: [
            'sandbox',
            'scripting',
            'json',
            'wasm',
            'rules-engine',
        ]
        categories: [
            'wasm',
            'encoding',
            'config',
            'development-tools',
            'compilers',
        ]
        exclude: [
            "content/*",
            "web/*",
            "docs/*",
            "stof/*",
            ".github/*",
            ".vscode/*",
            "*.gif",
            "*.png",
        ]
    }

    Target lib: {
        crate-type: ['cdylib', 'lib']
        bench: false
        doctest: false

        #[init]
        fn init_name() {
            // Set the lib name to "pystof" when building for python (default features contains "py" feature).
            if (super.features.default.contains('py')) self.name = 'pystof';
        }
    }

    features: {
        default: ['basic']
        basic: ['stof_std', 'system', 'pkg', 'log', 'stacker']
        full: ['stof_std', 'system', 'pkg', 'log', 'stacker', 'image', 'docx', 'pdf', 'http', 'tokio', 'age_encrypt']

        stof_std: ['dep:regex']
        system: []
        pkg: ['dep:zip', 'dep:regex', 'dep:walkdir']
        log: ['dep:log']

        /// grow the stack for deeply nested documents instead of overflowing (native targets; not wasm)
        stacker: ['dep:stacker']
        image: ['dep:image']
        docx: ['dep:docx-rs']
        pdf: ['dep:lopdf', 'image']
        http: ['dep:reqwest']
        tokio: ['dep:tokio']
        age_encrypt: ['dep:age']

        /// python bindings for stof with full functionality (TODO min/sandboxing)
        /// when building for python, set this as the only "default" feature
        py: [
            'full',
            'dep:pyo3',
        ]

        /// wasm/js version of the runtime
        /// should be the only feature enabled when building for the wasm target
        js: [
            'stof_std',
            'age_encrypt',
            'dep:js-sys',
            'dep:wasm-bindgen',
            'dep:serde-wasm-bindgen',
            'dep:getrandom',
            'dep:wasm-bindgen-futures',
            'dep:web-sys',
            'dep:console_error_panic_hook',
        ]
    }

    /// Release builds: whole-program optimization (smaller binaries and wasm, slightly faster).
    profile: {
        release: {
            lto: 'fat'
            codegen-units: 1
        }
    }

    dependencies: {
        base64: 0.22.1
        bincode: 1.3.3
        indexmap: {
            version: 2.14.2
            features: ['serde']
        }
        bytes: {
            version: 1.12.1
            features: ['serde']
        }
        colored: 3.1.1
        docx-rs: {
            version: 0.4.22
            optional: true
        }
        image: {
            version: 0.25.10
            features: ['serde']
            optional: true
        }
        lazy_static: 1.5.0
        markdown: {
            version: 1.0.0
            features: ['serde']
        }
        nanoid: 0.4.0
        compact_str: {
            version: 0.9.1
            features: ['serde']
        }
        lopdf: {
            version: 0.45.0
            features: ['serde']
            optional: true
        }
        regex: {
            version: 1.13.1
            optional: true
        }
        serde: {
            version: 1.0.229
            features: ['derive', 'rc']
        }
        serde_json: {
            version: 1.0.151
            features: ['preserve_order']
        }
        serde_yaml: 0.9.34
        toml: {
            version: 0.9.12
            features: ['preserve_order']
        }
        typetag: 0.2.23
        urlencoding: 2.1.3
        walkdir: {
            version: 2.5.0
            optional: true
        }
        zip: {
            version: 4.6.1
            optional: true
        }
        chrono: 0.4.45
        tokio: {
            version: 1.53.1
            features: ['full']
            optional: true
        }
        reqwest: {
            version: 0.12.28
            optional: true
            features: ['blocking']
        }
        rustc-hash: 2.1.3
        imbl: {
            version: 7.0.2
            features: ['serde', 'triomphe']
        }
        arcstr: {
            version: 1.2.0
            features: ['serde']
        }
        nom: 8.0.0
        parking_lot: {
            version: 0.12.5
            features: ['serde']
        }
        age: {
            version: 0.11.5
            optional: true
            features: ['web-sys'] // use web_sys::SystemTime when wasm target
        }
        log: {
            version: 0.4.34
            optional: true
        }
        stacker: {
            version: 0.1.25
            optional: true
        }
        web-time: {
            version: 1.1.0
            features: ['serde']
        }

        /*****************************************************************************
         * Python features.
         *****************************************************************************/
        pyo3: {
            version: 0.29.3
            optional: true
            features: [
                'macros',
                'chrono',
                'chrono-tz',
                'hashbrown',
                'indexmap',
                'generate-import-lib',
                'extension-module',
            ]
        }

        /*****************************************************************************
         * JS features.
         *****************************************************************************/
        wasm-bindgen: {
            version: 0.2.129
            optional: true
        }
        wasm-bindgen-futures: {
            version: 0.4.79
            optional: true
        }
        serde-wasm-bindgen: {
            version: 0.6.5
            optional: true
        }
        js-sys: {
            version: 0.3.106
            optional: true
        }
        getrandom: {
            version: 0.2.17
            optional: true
            features: ['js']
        }
        web-sys: {
            version: 0.3.106
            optional: true
            features: ['console', 'Window']
        }
        console_error_panic_hook: {
            version: 0.1.7
            optional: true
        }
    }
}

/// GitHub.
github: {
    funding: 'dev-formata-io'
    
    #[run]
    workflows: [
        {
            name: 'Rust'
            on: {
                push: {
                    branches: ['main']
                }
                pull_request: {
                    branches: ['main']
                }
            }
            env: {
                CARGO_TERM_COLOR: 'always'
            }
            jobs: {
                build: {
                    runs-on: 'ubuntu-latest'
                    steps: [
                        {
                            uses: 'actions/checkout@v4'
                        },
                        {
                            name: 'Build'
                            run: 'cargo build --verbose'
                        },
                        {
                            name: 'Run tests'
                            run: 'cargo test --verbose -- --nocapture'
                        }
                    ]
                }
            }
        } as GitHub.Workflow
    ]

    #[run]
    /// Generate GitHub FUNDING.yml.
    fn generate_funding_yaml() {
        const object = new { github: self.funding };
        const yaml = stringify('yaml', object);
        drop(object);
        fs.write('.github/FUNDING.yml', yaml);
    }
}


/// pyproject.toml definition.
pyproject: {
    project: {
        name: <CargoPackage>.name
        version: <CargoPackage>.version
        description: <CargoPackage>.description
        license: <CargoPackage>.license
        authors: [
            {
                name: 'CJ Cummings'
                email: 'cj@stof.dev'
            }
        ]
        readme: 'README.md'
        requires-python: '>=3.7'
        classifiers: [
            "Programming Language :: Rust",
            "Programming Language :: Python :: Implementation :: CPython",
            "Programming Language :: Python :: Implementation :: PyPy",
            "License :: OSI Approved :: Apache Software License",
            "Operating System :: OS Independent",
            "Topic :: Software Development :: Interpreters",
            "Topic :: Scientific/Engineering :: Artificial Intelligence",
        ]
        keywords: [
            'sandbox',
            'json',
            'rules-engine',
            'ai-agents',
            'llm',
            'wasm',
            'scripting',
            'embedded',
        ]
        urls: {
            Documentation: <CargoPackage>.homepage
            Repository: <CargoPackage>.repository
        }
    }

    build-system: {
        requires: ['maturin>=1,<2']
        build-backend: 'maturin'
    }
}


/*****************************************************************************
 * Generate functions.
 *****************************************************************************/

/// Generate Cargo.toml file.
async fn generate_cargo_toml() {
    const out = await Rust.Cargo.generate(self.cargo, update = false);
    fs.write('Cargo.toml', out);
    pln('Cargo .. ok');
}


/// Generate python project toml.
async fn generate_pyproject_toml() {
    const out = stringify('toml', self.pyproject);
    fs.write('pyproject.toml', out);
    pln('pyproject .. ok');
}


/// Generate GitHub configurations.
async fn generate_github() {
    self.github.run();
    pln('GitHub .. ok');
}


/*****************************************************************************
 * Main functions.
 *****************************************************************************/

#[main]
/// `stof run project.stof`
fn main() {
    await [
        self.generate_cargo_toml(),
        self.generate_github(),
    ];
    pln('done');
}


#[javascript]
/// `stof run project.stof -a javascript`
fn javascript_main() {
    // set js features
    self.cargo.features.default = ['js'];

    await [
        self.generate_cargo_toml(),
        self.generate_github(),
    ];
    pln('javascript config done');
}


#[python]
/// `stof run project.stof -a python`
fn python_main() {
    // set py features and name
    self.cargo.features.default = ['py'];
    self.cargo.lib.name = 'pystof';

    await [
        self.generate_cargo_toml(),
        self.generate_github(),
        self.generate_pyproject_toml(),
    ];
    pln('python config done');
}
